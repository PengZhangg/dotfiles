[user]
	name = pengzhangg
	email = pengzhang720@gmail.com
[core]
	editor = nvim
	pager = delta
	excludesfile = ~/.gitignore_global
	autocrlf = input
	safecrlf = true
[init]
	defaultBranch = main
[pull]
	rebase = false
[color]
	ui = auto
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	side-by-side = true
[diff]
	colorMoved = default
[rebase]
	autosquash = true
[push]
	autoSetupRemote = true
[alias]
	adog   = log --all --decorate --oneline --graph
	amend  = commit --amend --no-edit
	undo   = reset --soft HEAD~1
	save   = stash push -m
